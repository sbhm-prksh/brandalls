  </main>
  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <h4>Brandall Brands</h4>
        <p>Reliable, compliant, and fast pharmaceutical distribution for your medical shop.</p>
      </div>
      <div>
        <h4>Contact</h4>
        <p>Email: sales@brandall.com</p>
        <p>Phone: +91 90000 00000</p>
      </div>
      <div>
        <h4>Hours</h4>
        <p>Mon - Sat: 9:00 AM - 7:00 PM</p>
        <p>Sunday: Closed</p>
      </div>
    </div>
    <div class="footer-note">© 2026 Brandall Brands. All rights reserved.</div>
  </footer>
  <script>
    const navToggle = document.querySelector('.nav-toggle');
    const navLinks = document.querySelector('.nav-links');
    const header = document.querySelector('.site-header');
    const accountToggle = document.querySelector('.account-toggle');
    const accountMenu = document.querySelector('.account-menu');
    if (navToggle && navLinks && header) {
      navToggle.addEventListener('click', () => {
        const isOpen = navLinks.classList.toggle('is-open');
        header.classList.toggle('nav-open', isOpen);
        navToggle.setAttribute('aria-expanded', String(isOpen));
      });
    }

    if (accountToggle && accountMenu) {
      accountToggle.addEventListener('click', () => {
        const isOpen = accountMenu.classList.toggle('is-open');
        accountToggle.setAttribute('aria-expanded', String(isOpen));
      });
      document.addEventListener('click', (event) => {
        if (!accountMenu.contains(event.target)) {
          accountMenu.classList.remove('is-open');
          accountToggle.setAttribute('aria-expanded', 'false');
        }
      });
    }
  </script>
</body>
</html>
