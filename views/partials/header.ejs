<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet" />
</head>
<body class="<%= user && user.role === 'admin' ? 'admin' : '' %>">
  <header class="site-header">
    <div class="container nav-wrapper">
      <a class="brand" href="/">
        <span class="brand-mark">BB</span>
        <div>
          <div class="brand-name">Brandall Brands</div>
          <div class="brand-tagline">Trusted Pharmaceutical Wholesale Partner</div>
        </div>
      </a>
      <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav class="nav-links">
        <a href="/about">About</a>
        <a href="/services">Services</a>
        <a href="/contact">Contact</a>
        <a href="/medicines">Medicines</a>
        <% if (user && user.role === 'admin') { %>
          <a href="/admin">Admin</a>
        <% } %>
        <% if (user) { %>
          <% if (user.role !== 'admin') { %>
            <a href="/cart">Cart</a>
          <% } %>
          <div class="account-menu">
            <button class="account-toggle" type="button" aria-label="Account menu" aria-expanded="false">
              <span class="avatar"><%= (user.owner_name || user.shop_name || 'U').slice(0,1).toUpperCase() %></span>
            </button>
            <div class="account-dropdown">
              <% if (user.role !== 'admin') { %>
                <a href="/account">My Account</a>
                <a href="/orders">My Orders</a>
              <% } else { %>
                <a href="/admin">Admin Dashboard</a>
                <a href="/admin/orders">Manage Orders</a>
              <% } %>
              <a href="/logout">Logout</a>
            </div>
          </div>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn btn-small" href="/register">Register</a>
        <% } %>
      </nav>
    </div>
  </header>

  <% if (flash) { %>
    <div class="flash <%= flash.type %>">
      <div class="container"><%= flash.message %></div>
    </div>
  <% } %>

  <main class="site-main">
