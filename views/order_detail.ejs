<%- include('partials/header') %>
<section class="page-hero">
  <div class="container">
    <h1>Order #<%= order.id %></h1>
    <p>Status: <span class="status <%= order.status.toLowerCase() %>"><%= order.status %></span></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="table-card">
      <table>
        <thead>
          <tr>
            <th>Medicine</th>
            <th>Qty</th>
            <th>Price</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(item => { %>
            <tr>
              <td><%= item.name %></td>
              <td><%= item.quantity %></td>
              <td>₹<%= item.price.toFixed(2) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="order-actions">
      <div class="total">Total: ₹<%= order.total_price.toFixed(2) %></div>
      <a class="btn btn-outline" href="<%= whatsappLink %>" target="_blank" rel="noopener">WhatsApp Summary</a>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
